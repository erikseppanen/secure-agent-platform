ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_WORKSPACE_ID=your-workspace-id-here
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=postgresql://sap:sap@localhost:5432/sap

# Local sentence-transformers model used for RAG embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Local cross-encoder used to rerank retrieved chunks.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Development tracing. Payloads may contain user/tool/document text, so disable
# TRACE_PAYLOADS in environments where that content should not be written to logs.
LOG_LEVEL=INFO
TRACE_PAYLOADS=true
TRACE_MAX_CHARS=2000
